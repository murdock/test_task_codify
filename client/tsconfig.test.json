{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "types": ["jest", "node"],
    "noEmit": true,
    "verbatimModuleSyntax": false
  },
  "include": ["src", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
