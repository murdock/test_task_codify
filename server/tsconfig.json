{
  "compilerOptions": {
    // Environment
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": "src",
    "outDir": "dist",
    // Node.js type support
    "lib": ["ES2022"],
    "types": ["node", "jest"],

    // Output
    "sourceMap": true,
    "declaration": false,
    "declarationMap": false,

    // Import / Export settings
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    // Type checking
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
  },
  "include": ["src"]
}
